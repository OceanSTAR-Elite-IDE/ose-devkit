  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.1",
    "@angular/cdk": "20.2.4",
    "@angular/common": "20.3.1",
    "@angular/compiler": "20.3.1",
    "@angular/core": "20.3.1",
    "@angular/forms": "20.3.1",
    "@angular/platform-browser": "20.3.1",
    "@angular/platform-browser-dynamic": "20.3.1",
    "@angular/router": "20.3.1",
    "blueimp-load-image": "^5.16.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@compodoc/compodoc": "^1.1.30",
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/angular": "^9.1.8",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/blueimp-load-image": "^5",
